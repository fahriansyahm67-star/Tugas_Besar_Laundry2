# ---------------- Fungsi bantu ----------------
def rupiah(angka: int) -> str:
    return "Rp " + f"{angka:,}".replace(",", ".")


def hitung():
    """Validasi input lalu hitung biaya. Hasil disimpan di session_state."""
    nim = st.session_state.nim.strip()
    berat_teks = st.session_state.berat.strip()

    st.session_state.hasil = None
    st.session_state.error = None

    # Validasi NIM: tepat 10 digit angka
    if not (nim.isascii() and nim.isdigit() and len(nim) == 10):
        st.session_state.error = "NIM tidak valid! NIM harus terdiri dari tepat 10 digit angka."
        return

    # Validasi berat: bilangan bulat > 0
    try:
        berat = int(berat_teks)
    except ValueError:
        st.session_state.error = "Berat cucian tidak valid! Masukkan bilangan bulat."
        return
    if berat <= 0:
        st.session_state.error = "Berat cucian harus lebih dari 0."
        return

    # Perhitungan
    digit_terakhir = int(nim[-1])
    tarif = 5000 + digit_terakhir * 500
    jumlah_genap = sum(1 for d in nim if int(d) % 2 == 0)
    persen_diskon = jumlah_genap  # banyak digit genap x 1 %
    biaya_normal = berat * tarif
    potongan = biaya_normal * persen_diskon // 100
    total = biaya_normal - potongan

    st.session_state.hasil = {
        "tarif": tarif,
        "genap": jumlah_genap,
        "diskon": persen_diskon,
        "normal": biaya_normal,
        "potongan": potongan,
        "total": total,
    }


def reset():
    st.session_state.nim = ""
    st.session_state.berat = ""
    st.session_state.hasil = None
    st.session_state.error = None


# ---------------- State awal ----------------
for kunci, nilai in {"nim": "", "berat": "", "hasil": None, "error": None}.items():
    if kunci not in st.session_state:
        st.session_state[kunci] = nilai

# ---------------- Form input ----------------
st.text_input("NIM (10 digit)", key="nim", max_chars=30)
st.text_input("Berat Cucian (kg)", key="berat")

kol1, kol2 = st.columns(2)
kol1.button("⚡ Hitung", on_click=hitung)
kol2.button("↻ Reset", on_click=reset)

# ---------------- Tampilan hasil ----------------
if st.session_state.error:
    st.error(st.session_state.error)

